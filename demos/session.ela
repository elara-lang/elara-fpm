res.header("Content-Type", "text/plain; charset=utf-8")
let n = session.get("n")
if n == nil {
  n = "0"
}
let next = "1"
if n == "0" { next = "1" }
if n == "1" { next = "2" }
if n == "2" { next = "3" }
if n == "3" { next = "4" }
if n == "4" { next = "5" }
session.set("n", next)
res.write("count=")
res.write(next)
res.write("\n")
