res.header("Content-Type", "text/plain; charset=utf-8")
let n = session.get("n")
if n == nil {
  n = 0
}
n = n + 1
session.set("n", n)
session.set("seen", true)
res.write("count=")
res.write(tostring(n))
res.write("\nseen=")
let flag = session.get("seen")
if flag {
  res.write("true")
} else {
  res.write("false")
}
res.write("\n")
